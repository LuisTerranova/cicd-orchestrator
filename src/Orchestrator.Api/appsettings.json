{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Storage": {
    "LogsPath": "/data/logs",
    "ArtifactsPath": "/data/artifacts"
  },
  "AllowedHosts": "*",
  "RunnerExpiry": {
    "InactivityThreshold": "00:02:00"
  }
}
