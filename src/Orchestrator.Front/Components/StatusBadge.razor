<span class="badge-custom @BadgeClass">@Status</span>

@code {
    [Parameter] public string Status { get; set; } = "";

    private string BadgeClass => Status?.ToLowerInvariant() switch
    {
        "passed" or "idle" => "badge-passed",
        "running" or "busy" => "badge-running",
        "failed" or "disconnected" or "revoked" => "badge-failed",
        "queued" or "pending" or "offline" => "badge-queued",
        "cancelled" or "skipped" => "badge-cancelled",
        _ => "badge-cancelled",
    };
}
